# Copier en .env.local. Sans ces variables, l'app tourne en mode démo (catalogue local).
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# URL du Worker Cloudflare. Laisser vide si le Worker est servi sur le même domaine (route /api/*).
VITE_API_URL=https://streamflix-api.your-account.workers.dev
